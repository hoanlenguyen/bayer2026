{
  "_note": "Fictional sample catalog for a pharma manufacturing plant. Replace with the Bayer synthetic dataset and a real catalog scan.",
  "measures": {
    "late_shipments": {
      "name": "Late shipments",
      "unit": "count",
      "dataset": "shipments_fact",
      "certified": true,
      "default_grain": "day",
      "definition": "Shipments whose actual delivery date is after the promised date, or not delivered by the promised date.",
      "expression": "COUNTROWS(FILTER(shipments_fact, shipments_fact[is_late] = TRUE()))",
      "keywords": [
        "late deliver",
        "late shipment",
        "delayed deliver",
        "delayed shipment",
        "overdue deliver",
        "delivery delay",
        "late order"
      ]
    },
    "days_late": {
      "name": "Average days late",
      "unit": "days",
      "dataset": "shipments_fact",
      "certified": true,
      "default_grain": "day",
      "definition": "Average number of days between promised and actual (or current) date for late shipments.",
      "expression": "AVERAGEX(FILTER(shipments_fact, shipments_fact[is_late]), shipments_fact[days_late])",
      "keywords": [
        "days late",
        "how late",
        "delay days"
      ]
    },
    "otif": {
      "name": "OTIF %",
      "unit": "%",
      "dataset": "shipments_fact",
      "certified": true,
      "default_grain": "week",
      "definition": "Share of shipments delivered on time and in full against the promised date and quantity.",
      "expression": "DIVIDE(CALCULATE(COUNTROWS(shipments_fact), shipments_fact[on_time_in_full]), COUNTROWS(shipments_fact))",
      "keywords": [
        "otif",
        "on time in full",
        "on-time",
        "delivery performance"
      ]
    },
    "oee": {
      "name": "OEE %",
      "unit": "%",
      "dataset": "line_events_fact",
      "certified": true,
      "default_grain": "day",
      "definition": "Availability × performance × quality for a packaging or filling line.",
      "expression": "[Availability] * [Performance] * [Quality rate]",
      "keywords": [
        "oee",
        "overall equipment",
        "line efficiency",
        "equipment effectiveness"
      ]
    },
    "output_vs_plan": {
      "name": "Output vs plan %",
      "unit": "%",
      "dataset": "production_batches_fact",
      "certified": true,
      "default_grain": "day",
      "definition": "Units produced divided by units planned in the production schedule.",
      "expression": "DIVIDE(SUM(production_batches_fact[units_produced]), SUM(production_batches_fact[units_planned]))",
      "keywords": [
        "output",
        "production volume",
        "vs plan",
        "against plan",
        "schedule adherence",
        "throughput"
      ]
    },
    "downtime_hours": {
      "name": "Unplanned downtime (h)",
      "unit": "hours",
      "dataset": "line_events_fact",
      "certified": true,
      "default_grain": "day",
      "definition": "Hours a line was stopped outside planned maintenance and changeovers.",
      "expression": "SUM(line_events_fact[unplanned_stop_hours])",
      "keywords": [
        "downtime",
        "stoppage",
        "line stop",
        "breakdown"
      ]
    },
    "batch_yield": {
      "name": "Batch yield %",
      "unit": "%",
      "dataset": "production_batches_fact",
      "certified": true,
      "default_grain": "day",
      "definition": "Good units released divided by theoretical units for the batch.",
      "expression": "DIVIDE(SUM(production_batches_fact[good_units]), SUM(production_batches_fact[theoretical_units]))",
      "keywords": [
        "yield",
        "batch yield",
        "scrap",
        "waste"
      ]
    },
    "open_deviations": {
      "name": "Open deviations",
      "unit": "count",
      "dataset": "quality_deviations",
      "certified": true,
      "default_grain": "day",
      "definition": "Quality deviations not yet closed, including those past their due date.",
      "expression": "COUNTROWS(FILTER(quality_deviations, quality_deviations[status] <> \"Closed\"))",
      "keywords": [
        "deviation",
        "non-conformance",
        "quality issue",
        "quality event"
      ]
    },
    "release_lead_time": {
      "name": "Batch release lead time (days)",
      "unit": "days",
      "dataset": "quality_deviations",
      "certified": true,
      "default_grain": "day",
      "definition": "Days from end of manufacturing to QA release of the batch.",
      "expression": "AVERAGE(batch_release[lead_time_days])",
      "keywords": [
        "release",
        "blocked batch",
        "batch release",
        "qa release",
        "release lead"
      ]
    },
    "right_first_time": {
      "name": "Right first time %",
      "unit": "%",
      "dataset": "production_batches_fact",
      "certified": true,
      "default_grain": "week",
      "definition": "Batches completed without deviation or rework divided by all completed batches.",
      "expression": "DIVIDE(COUNTROWS(FILTER(production_batches_fact, production_batches_fact[rft])), COUNTROWS(production_batches_fact))",
      "keywords": [
        "right first time",
        "rft",
        "first pass"
      ]
    },
    "days_of_supply": {
      "name": "Days of supply",
      "unit": "days",
      "dataset": "inventory_snapshot",
      "certified": true,
      "default_grain": "day",
      "definition": "On-hand quantity divided by average daily consumption over the last 28 days.",
      "expression": "DIVIDE(SUM(inventory_snapshot[on_hand_qty]), [Avg daily consumption 28d])",
      "keywords": [
        "days of supply",
        "stock cover",
        "inventory cover",
        "stock-out",
        "stockout",
        "run out",
        "shortage",
        "materials risk"
      ]
    },
    "absenteeism": {
      "name": "Absenteeism %",
      "unit": "%",
      "dataset": "hr_attendance",
      "certified": true,
      "default_grain": "month",
      "definition": "Unplanned absence hours divided by scheduled hours.",
      "expression": "DIVIDE(SUM(hr_attendance[absence_hours]), SUM(hr_attendance[scheduled_hours]))",
      "keywords": [
        "absence",
        "absenteeism",
        "sick",
        "staffed",
        "staffing"
      ]
    },
    "gmp_training": {
      "name": "GMP training compliance %",
      "unit": "%",
      "dataset": "training_records",
      "certified": true,
      "default_grain": "month",
      "definition": "Employees with all mandatory GMP training current divided by employees requiring it.",
      "expression": "DIVIDE([Employees compliant], [Employees in scope])",
      "keywords": [
        "training",
        "gmp training",
        "qualified",
        "certification of staff"
      ]
    },
    "budget_variance": {
      "name": "Budget variance %",
      "unit": "%",
      "dataset": "cost_ledger",
      "certified": true,
      "default_grain": "month",
      "definition": "Actual cost minus budget, divided by budget.",
      "expression": "DIVIDE(SUM(cost_ledger[actual]) - SUM(cost_ledger[budget]), SUM(cost_ledger[budget]))",
      "keywords": [
        "budget",
        "variance",
        "against budget",
        "overspend"
      ]
    },
    "cost_per_unit": {
      "name": "Cost per unit",
      "unit": "EUR",
      "dataset": "cost_ledger",
      "certified": true,
      "default_grain": "month",
      "definition": "Total manufacturing cost divided by good units produced.",
      "expression": "DIVIDE(SUM(cost_ledger[actual]), [Good units])",
      "keywords": [
        "cost per unit",
        "unit cost",
        "cost"
      ]
    }
  },
