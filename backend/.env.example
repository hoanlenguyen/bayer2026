# Copy to .env and fill in. Never commit .env.

# Model provider: auto (openai if OPENAI_API_KEY is set, else mock), openai, or mock
LLM_PROVIDER=auto
OPENAI_API_KEY=
# Optional: an OpenAI-compatible endpoint, for example an Azure-hosted deployment
OPENAI_BASE_URL=
# Check the exact model IDs in your OpenAI dashboard
MODEL_REASONING=gpt-6-astra
MODEL_FAST=gpt-6-luna

# Local demo persistence: SQLite by default. Use memory only for disposable tests.
STORE_MODE=sqlite
SQLITE_PATH=data/workbench.sqlite
# Explicit demo actors; false disables access until a production identity adapter exists.
DEMO_MODE=true
# Optional stable signing secret from your runtime secret store. Empty = new sessions after restart.
SESSION_SECRET=
# Optional MongoDB. A configured but unavailable server fails startup; no silent fallback.
MONGODB_URI=
MONGODB_DB=analytics_manager

# Folder for generated PBIP projects (relative to backend/)
OUTPUT_DIR=output
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Pause between stages so the flow is visible in the UI (seconds)
STAGE_DELAY=0.35
# Path to the Bayer data pack (default: ../materials/Bayer_Pharmaceuticals_SinceAI_2026_FINAL_Builder_Data_Pack.xlsx)
DATAPACK_PATH=
