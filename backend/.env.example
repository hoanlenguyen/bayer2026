# Copy to .env and fill in. Never commit .env.

# Model provider: auto (openai if OPENAI_API_KEY is set, else mock), openai, or mock
LLM_PROVIDER=auto
OPENAI_API_KEY=
# Optional: an OpenAI-compatible endpoint (must start with https://), for example Azure. Leave empty for OpenAI.
OPENAI_BASE_URL=
# Check the exact model IDs in your OpenAI dashboard
MODEL_REASONING=gpt-6-astra
MODEL_FAST=gpt-6-luna

# Jev (TypeSafe AI), a decision model for classification. Off unless a key is set and JEV_PHASES names phases.
# Requests go to TypeSafe, hosted in the US. Turn a phase on only after python scripts/eval_classification.py supports it.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.14.0
# Comma separated: relevance, kpis, urgency
JEV_PHASES=

# Vector search embeddings: auto (OpenAI when OPENAI_API_KEY is set), openai, or local (offline, no network).
# Use local if your network blocks api.openai.com. Re-run python -m app.build_vectors after changing it.
EMBEDDINGS=auto
EMBED_MODEL=text-embedding-3-small
EMBED_DIMS=1536

# MongoDB. Leave empty to use in-memory storage.
MONGODB_URI=
MONGODB_DB=analytics_manager

# Folder for generated PBIP projects (relative to backend/)
OUTPUT_DIR=output
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Pause between stages so the flow is visible in the UI (seconds)
STAGE_DELAY=0.35
# Path to the SinceAI data pack (default: ../materials/Bayer_Pharmaceuticals_SinceAI_2026_FINAL_Builder_Data_Pack.xlsx)
DATAPACK_PATH=
